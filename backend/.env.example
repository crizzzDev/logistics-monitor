# Puerto donde escucha la API (Render asigna PORT automáticamente)
PORT=4000

# Orígenes permitidos para CORS, separados por comas.
# En desarrollo el frontend de Vite corre en http://localhost:5173
# En producción, poner el dominio del frontend desplegado, por ejemplo:
# CORS_ORIGIN=https://logistics-monitor-web.onrender.com
# Usar * para permitir cualquier origen (cómodo para evaluación, menos seguro).
CORS_ORIGIN=*
